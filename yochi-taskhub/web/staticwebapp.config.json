{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_next/*", "/addin/*", "/*.{css,js,ico,png,svg,txt,json,woff2}"]
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
